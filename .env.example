# Names only. Real values live in .env (Stripe Projects) and .env.local (git-ignored).
CREATEOS_SANDBOX_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NEON_POSTGRES_CONNECTION_STRING=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fallback providers (used in order after Gemini; need BOTH key and model). Free tiers change and may train on prompts.
LLM_PROVIDERS=gemini,groq,openrouter,nvidia,mistral,cerebras,sambanova,huggingface,llm7
# Each fallback is used only if BOTH its key and model are set (copy the exact model id from the provider's dashboard).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
LLM7_API_KEY=
LLM7_MODEL=
# Pauses (ms) before each retry of a transient error (429/5xx/timeout) on the same provider; empty disables retries.
# Your own OpenAI-compatible provider, no code change: pick a name, e.g. together, set these three, and add the name to LLM_PROVIDERS.
# The base URL must be https:// with no login in it. Built-in names (groq, mistral, ...) and gemini cannot be overridden.
# LLM_TOGETHER_BASE_URL=https://api.together.xyz/v1
# LLM_TOGETHER_API_KEY=
# LLM_TOGETHER_MODEL=
LLM_RETRY_DELAYS_MS=1500,4000
# Total time one model call may spend across all providers and retries (ms). Keep two of these well under the 300 s function limit.
LLM_TOTAL_BUDGET_MS=100000
# Longest a single provider call may take (ms), so a hung provider cannot use up the budget before the fallbacks run.
LLM_CALL_TIMEOUT_MS=45000
# Output tokens requested from each provider. Too low and a reasoning model's reply is cut off mid-code.
LLM_MAX_OUTPUT_TOKENS=8192
# Shared demo passcode (any string); protects rounds, approvals and demo credits
DEMO_PASSCODE=

# Optional: base64 Ed25519 PKCS8 private key that signs report-chain entries (see src/lib/evidence.ts for the one-liner to generate it)
REPORT_SIGNING_KEY=

# Optional: pay rounds with a Stripe card hold. always (default) = charge every completed round; on_green = charge only gate-passing proposals
CARD_CAPTURE_POLICY=

# Optional: Veloce ProofMint as a Veloce adapter (adapter id veloce-proofmint; h1 surface at /h1/<operation>, Veloce ADR-020). Off unless exactly "true".
# Rounds the Veloce host starts get every model answer from the host (with the host's grant, no fallback to the keys above);
# Forge's wallet then pays only sandbox time and the round fee. Every setting below is required when it is on.
FORGE_H1_ENABLED=
# The client's tenant slug on the Veloce host
VELOCE_TENANT_SLUG=
# JSON list of the host's Ed25519 public keys in PEM (1 to 3, for key rotation), e.g. ["-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"]
VELOCE_HOST_PUBLIC_KEYS=
# The host's model.call address (https), and the provider and model the host allows for this adapter
VELOCE_HOST_MODEL_URL=
VELOCE_HOST_MODEL_PROVIDER=
VELOCE_HOST_MODEL=
